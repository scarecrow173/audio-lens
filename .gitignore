# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# dotenv environment variable files
.env
.env.*
!.env.example

# Logs and local temporary files
logs
*.log
tmp/

# Language artifacts (stack undecided; common entries only)
node_modules/
.venv/
__pycache__/
*.py[cod]
dist/
build/
*.egg-info/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# mise local state — .mise/locks/ stays un-ignored because mise lockfile
# revision 2 stores dep-graph sidecars there for pypi/npm-resolved tools
# (mise.lock references them by digest; a missing sidecar breaks
#  reproducible toolchain restores)
.mise/*
!.mise/locks/

# APM dependencies
apm_modules/

# APM deployed artifacts — regenerated by `apm install` / `apm compile`
# Only apm.yml and apm.lock.yaml are tracked
.agents/
.claude/agents/
.claude/apm-hooks.json
.claude/commands/
.claude/hooks/
.claude/settings.json
.claude/skills/
.codex/agents/
.codex/apm-hooks.json
.codex/config.toml
.codex/hooks/
.codex/hooks.json
.codex/prompts/
.cursor/agents/
.cursor/apm-hooks.json
.cursor/commands/
.cursor/rules/
.cursor/hooks/
.cursor/hooks.json
.cursor/mcp.json
.github/agents/
.github/apm-hooks.json
.github/commands/
.github/extensions/
.github/hooks/
.github/instructions/
.github/prompts/
.github/skills/
.github/copilot-instructions.md
.github/mcp.json
.mcp.json
.vscode/mcp.json
.windsurf/agents/
.windsurf/apm-hooks.json
.windsurf/hooks/
.windsurf/hooks.json
.windsurf/rules/
.windsurf/workflows/

# SDP generated artifacts (regenerate via skill-discovery-protocol)
.sdp/

# Serena MCP generated artifacts
.serena/

# Rust build artifacts
target/

# Sample verification runs (regenerate: see samples/README.md)
samples/_runs/
samples/**/*.png
