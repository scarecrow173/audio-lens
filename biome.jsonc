{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      // 生成対象は決定論的な静的 scene で、描画 list は reorder されない。
      // index key 使用を禁じる趣旨(状態破壊)が成立しないため tool 配下では
      // noArrayIndexKey を off にする。
      "includes": ["tools/cinematic-sword-cutscene/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**/*.js",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.mts",
      "**/*.cts",
      "**/*.jsx",
      "**/*.tsx",
      "**/*.json",
      "**/*.jsonc",
      "!**/node_modules",
      "!**/dist",
      "!tools/cinematic-sword-cutscene/package-lock.json",
      "!ui/package-lock.json",
      // baseline の計測・収集ツールが生成する成果物(決定論的な機械生成物)
      "!baseline/runs",
      "!baseline/bench"
    ]
  }
}
