# .worktreeinclude — Git-ignored assets copied into new worktrees
# Keep entries as explicit Git-ignored paths, distinct from tracked files.

# APM package sources and deployed agent assets — let worktree agents use
# skills/hooks/commands immediately without re-running `apm install`
apm_modules/
.agents/
.sdp/

# Vendored ruviform ui/* TS sources — regenerated by tools/sync-ruviform-ui.mjs
# at the Cargo.lock resolved SHA, but copied so worktree agents avoid a network fetch
ui/vendor/

# Deployed agent assets under tool dirs. The parent dirs (.claude/ etc.) are
# NOT gitignored — .gitignore only ignores these child paths, so each literal
# required child paths are listed explicitly.
.claude/agents/
.claude/apm-hooks.json
.claude/commands/
.claude/hooks/
.claude/settings.json
.claude/skills/
.codex/agents/
.codex/apm-hooks.json
.codex/config.toml
.codex/hooks/
.codex/hooks.json
.codex/prompts/
.cursor/agents/
.cursor/apm-hooks.json
.cursor/commands/
.cursor/hooks/
.cursor/hooks.json
.cursor/mcp.json
.cursor/rules/
.github/agents/
.github/apm-hooks.json
.github/commands/
.github/copilot-instructions.md
.github/extensions/
.github/hooks/
.github/instructions/
.github/mcp.json
.github/prompts/
.github/skills/
.mcp.json
.vscode/mcp.json
.windsurf/agents/
.windsurf/apm-hooks.json
.windsurf/hooks/
.windsurf/hooks.json
.windsurf/rules/
.windsurf/workflows/

# Local environment files — explicit paths
.env
.env.local
.env.development
.env.production
.env.test

# Deliberately not copied (regenerable or path-coupled):
#   target/           Rust build artifacts
#   .serena/          Serena local state (absolute paths; re-created per checkout)
#   node_modules/ .venv/ dist/ build/    package/build outputs
#   logs/ tmp/ *.log .pytest_cache/ etc. transient files
#   .mise/            mise local state (tracked files arrive via checkout)
#   samples/_runs/ samples/**/*.png      verification runs (and globs)
