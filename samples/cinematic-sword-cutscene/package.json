{
  "name": "cinematic-sword-cutscene",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic game-capture style demo video generator for audio-lens comparison fixtures",
  "scripts": {
    "dev": "remotion studio",
    "render:test": "remotion render GameCaptureTest ../game-capture/test/game-capture-test.mp4",
    "render:normal": "remotion render GameCaptureNormal ../game-capture/normal/game-capture-normal.mp4",
    "render:variants": "node scripts/render-variants.ts",
    "inspect:kaykit": "node scripts/inspect-kaykit.ts",
    "audio:gen": "node scripts/audio/gen-audio.ts",
    "audio:voice": "uv run scripts/audio/gen_voice.py && node scripts/audio/postprocess-voice.ts",
    "audio:all": "npm run audio:voice && npm run audio:gen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/three": "4.0.531",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.531",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.531",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
